# 951 parameters from three repeated groups (P2). The groups expand to ordinary parameters:
#   band_1_freq ... band_24_on     (IDs 2000 + (n-1) * 64 + offset, as in a 24-band EQ spec)
#   slot_1_a ... slot_50_p           (IDs 4000 + (n-1) * 16 + offset)
#   pad_1_x ... pad_6_mode         (no id_base: IDs are the hashes of the keys)
# and the plugin reads them as ctx.params().band[i].freq.value() and so on.
[plugin]
id     = "dev.ferritron.examples.eq-bands"
name   = "Ferritron Eq Bands"
vendor = "Ztraqto"

[params]
master = { type = "float", range = [-24, 24], default = 0, unit = "dB", id = 1, smooth = "20ms" }

[params.band]
repeat  = 24
key     = "band_{n}_"
name    = "Band {n} "
id_base = "2000 + (n-1)*64"

[params.band.fields]
freq = { type = "float", range = [20, 20000], default = 1000, scale = "log", unit = "Hz", smooth = { time = "10ms", kind = "log" }, offset = 2 }
gain = { type = "float", range = [-24, 24], default = 0, unit = "dB", smooth = "20ms", offset = 3 }
q    = { type = "float", range = [0.1, 20], default = 1, scale = "log", offset = 4 }
type = { type = "enum", choices = ["Bell", "Low shelf", "High shelf", "Notch"], offset = 5 }
on   = { type = "bool", default = true, offset = 6 }

[params.slot]
repeat    = 50
key       = "slot_{n}_"
name      = "Slot {n} "
id_base   = 4000
id_stride = 16

[params.slot.fields]
a = { type = "float", range = [-1, 1], default = 0, offset = 0 }
b = { type = "float", range = [-1, 1], default = 0, offset = 1 }
c = { type = "float", range = [-1, 1], default = 0, offset = 2 }
d = { type = "float", range = [-1, 1], default = 0, offset = 3 }
e = { type = "float", range = [-1, 1], default = 0, offset = 4 }
f = { type = "float", range = [-1, 1], default = 0, offset = 5 }
g = { type = "float", range = [-1, 1], default = 0, offset = 6 }
h = { type = "float", range = [-1, 1], default = 0, offset = 7 }
i = { type = "float", range = [-1, 1], default = 0, offset = 8 }
j = { type = "float", range = [-1, 1], default = 0, offset = 9 }
k = { type = "float", range = [-1, 1], default = 0, offset = 10 }
l = { type = "float", range = [-1, 1], default = 0, offset = 11 }
m = { type = "float", range = [-1, 1], default = 0, offset = 12 }
n = { type = "float", range = [-1, 1], default = 0, offset = 13 }
o = { type = "float", range = [-1, 1], default = 0, offset = 14 }
p = { type = "float", range = [-1, 1], default = 0, offset = 15 }

[params.pad]
repeat = 6
key    = "pad_{n}_"

[params.pad.fields]
x    = { type = "float", range = [0, 1], default = 0.5 }
y    = { type = "float", range = [0, 1], default = 0.5 }
size = { type = "int", range = [1, 8], default = 2 }
mode = { type = "enum", choices = ["Free", "Snap"], default = "Free", hidden = true }
lock = { type = "bool", automatable = false }
