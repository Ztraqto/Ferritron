@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

# Generated by `cargo ferritron bundle` from the project file.

<urn:ferritron:{id}>
    a lv2:Plugin ;
    lv2:binary <{binary.uri}> ;
    rdfs:seeAlso <plugin.ttl> .
{#view}
<urn:ferritron:{id}>
    ui:ui <urn:ferritron:{id}#ui> .

<urn:ferritron:{id}#ui>
    a ui:WindowsUI ;
    ui:binary <{binary.uri}> ;
    lv2:requiredFeature ui:parent ;
    lv2:optionalFeature ui:resize, ui:touch, opts:options, <http://lv2plug.in/ns/ext/instance-access> ;
    lv2:extensionData ui:idleInterface, ui:resize .
{/view}
