@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:   <http://lv2plug.in/ns/ext/options#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state:  <http://lv2plug.in/ns/ext/state#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .

# Generated by `cargo ferritron bundle` from the project file. Port order
# (must match ferritron-lv2): the parameters, the audio ports, the MIDI
# input (instruments), latency, freewheel.

<urn:ferritron:{id}>
    a lv2:Plugin, {#instrument}lv2:InstrumentPlugin{/instrument}{^instrument}lv2:UtilityPlugin{/instrument} ;
    doap:name "{name}" ;
    doap:maintainer [ foaf:name "{vendor}" ] ;
    rdfs:comment "{name} {version}" ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable, opts:options, bufsz:boundedBlockLength ;
    opts:supportedOption bufsz:maxBlockLength, bufsz:nominalBlockLength ;
    lv2:extensionData state:interface ;
    lv2:port
{#params}    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index {index} ;
        lv2:symbol "{symbol}" ;
        lv2:name "{name}" ;
        lv2:default {default} ;
        lv2:minimum {min} ;
        lv2:maximum {max} ;{#bool}
        lv2:portProperty lv2:toggled ;{/bool}{#int}
        lv2:portProperty lv2:integer ;{/int}{#enum}
        lv2:portProperty lv2:integer, lv2:enumeration ;{#choices}
        lv2:scalePoint [ rdfs:label "{name}" ; rdf:value {index} ] ;{/choices}{/enum}{#hidden}
        lv2:portProperty pprops:notOnGUI ;{/hidden}{^automatable}
        lv2:portProperty pprops:notAutomatic ;{/automatable}{#unit}
        units:unit [ a units:Unit ; rdfs:label "{unit}" ; units:symbol "{unit}" ] ;{/unit}
    ] ,
{/params}{#effect}    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index {after.0} ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index {after.1} ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index {after.2} ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index {after.3} ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index {after.4} ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency, lv2:integer, pprops:notOnGUI
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index {after.5} ;
        lv2:symbol "freewheel" ;
        lv2:name "Freewheel" ;
        lv2:designation lv2:freeWheeling ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled, pprops:notOnGUI
    ] .
{/effect}{#instrument}    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index {after.0} ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index {after.1} ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:designation lv2:control ;
        lv2:index {after.2} ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index {after.3} ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency, lv2:integer, pprops:notOnGUI
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index {after.4} ;
        lv2:symbol "freewheel" ;
        lv2:name "Freewheel" ;
        lv2:designation lv2:freeWheeling ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled, pprops:notOnGUI
    ] .
{/instrument}
